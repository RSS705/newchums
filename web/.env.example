# NewChums web — copy to `.env.local` and fill in values (`.env.local` is gitignored).
# Do not commit secrets. See docs/Development_Setup_Guide.md § Environment Files.
#
# Minimum for local dev (auth + DB): DATABASE_URL, AUTH_SECRET, AUTH_TRUST_HOST, AUTH_URL,
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET. AUTH_SECRET must match api/.dev.vars NEXTAUTH_SECRET.
#
# `npm run dev` loads `.env.development` first; this file documents overrides for `.env.local`.

# --- Database (Neon or compatible) — same connection string as api/.dev.vars DATABASE_URL ---
DATABASE_URL=

# --- Auth.js — AUTH_SECRET must equal api/.dev.vars NEXTAUTH_SECRET (JWT verification across web + API) ---
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# --- Google OAuth (Credentials + Google provider in web/src/auth.ts) ---
# GOOGLE_CLIENT_ID appears in web/wrangler.toml [vars] for deployed Worker; use the same client or a dev client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Public URLs (defaults exist in .env.development; override here if needed) ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# --- Used by scripts/check-env.mjs; leave empty for local if not using Sentry/Plausible ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=newchums.com

# --- Optional: maps / Places (profile location, event map embeds) ---
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Optional: contact page Turnstile (public site key; secret is API-only) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Optional: when local web uses prod API/R2 for avatars (see Technical_Specs.md) ---
# NEXT_PUBLIC_AVATAR_BASE_URL=
