# Production API — used by `next build` when deploying. Deploy script overrides to ensure prod URL.
NEXT_PUBLIC_API_BASE_URL=https://newchums-api.robsmith775.workers.dev
# Canonical avatar origin — same as API; avatars load from prod R2 for cross-env consistency when sharing DB.
NEXT_PUBLIC_AVATAR_BASE_URL=https://newchums-api.robsmith775.workers.dev
