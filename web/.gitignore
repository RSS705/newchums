# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.development
!.env.production

# vercel
.vercel

# OpenNext / Cloudflare Workers build output
.open-next

# Wrangler local state
.wrangler

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# Sentry Config File
.env.sentry-build-plugin

# Local session-cookie helpers for UI verification (must live in web/ for
# @auth/core import resolution; never part of the app)
mintcookie*.mjs
