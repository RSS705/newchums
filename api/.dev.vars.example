# NewChums API, copy to .dev.vars and fill values
# Wrangler loads .dev.vars for local dev (wrangler dev --local)
# Run from api/ directory. After editing, restart npm run dev.
APP_ENV=development

# Database, REQUIRED: paste your Neon connection string (same as web/.env.local)
# Must be non-empty. No spaces around =. Use quotes if the URL contains spaces.
DATABASE_URL=

# Auth (required for profile, user/username, user/date-of-birth; must match web AUTH_SECRET)
NEXTAUTH_SECRET=

# Email (Resend). EMAIL_FROM should be "NewChums <no-reply@newchums.com>" in prod;
# any verified Resend sender works in dev.
RESEND_API_KEY=
EMAIL_FROM=
WEB_BASE_URL=http://localhost:3000

# Observability
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=

# Optional: Cloudflare Turnstile for contact form (logged-out). Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# TURNSTILE_SECRET_KEY=

# Optional: for internal test routes in production
# INTERNAL_TEST_TOKEN=
